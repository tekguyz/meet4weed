# Hosted Supabase project — Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses every RLS policy. Server only. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Card reading (claude-sonnet-5). Server only. Set a monthly spend limit in the
# Anthropic console as well — see spec §4.4.
ANTHROPIC_API_KEY=

# Rate limits and the daily verification ceiling. Shared with the TEKGUYZ
# Website database; every Meet4Weed key is prefixed m4w:.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App-sent email (owner review alert, expiry notice). Auth email does NOT use
# this: it goes through Resend SMTP configured in the Supabase dashboard.
RESEND_API_KEY=
