# Hosted Supabase project — Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses every RLS policy. Server only. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Card reading (claude-sonnet-5). Server only. Set a monthly spend limit in the
# Anthropic console as well — see spec §4.4.
ANTHROPIC_API_KEY=

# Rate limits and the daily verification ceiling. Shared with the TEKGUYZ
# Website database; every Meet4Weed key is prefixed m4w:.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App-sent email (owner review alert, expiry notice). Auth email does NOT use
# this: it goes through Resend SMTP configured in the Supabase dashboard.
RESEND_API_KEY=

# Root of the image-encryption and challenge-signing keys. 32 random bytes,
# base64. Server only. Changing it makes stored images unreadable; they live
# at most 7 days, so rotate by waiting for the queue to empty.
VERIFICATION_SECRET=

# Vercel Cron sends this as a bearer token to /api/cron/*. Server only.
CRON_SECRET=

# Who receives the "a new card is waiting for review" email.
OWNER_ALERT_EMAIL=

# Web push (#56). The project's own VAPID pair, no push vendor. Generate with
# `npx web-push generate-vapid-keys`. The public half reaches the browser; the
# private half is server only. Without both, push is off. Changing the pair
# silently orphans every saved device: members must turn push on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional. Claude checks per day for the whole app (spec §4.4 item 4).
# VISION_DAILY_CEILING=50

# Development only. Password of dev@meet4weed.test, the account
# GET /api/dev-login signs in. Leave it out: the route writes a random one here
# in .env.local on first use.
# DEV_LOGIN_PASSWORD=
